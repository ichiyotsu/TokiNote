<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TokiNote.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="tokinote">
    <Grid x:Name="Root" Width="384" Height="256" Background="Transparent" PointerPressed="Root_PointerPressed">
        <Grid x:Name="Card" Margin="8" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.86" ScaleY="0.86" />
            </Grid.RenderTransform>
            <Grid x:Name="ShadowHost" />
            <Border x:Name="CardFill" CornerRadius="36" />
            <TextBlock
                x:Name="Wordmark"
                Text="tokinote"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="ms-appx:///Assets/Fonts/GoogleSansFlex.ttf#Google Sans Flex, Microsoft YaHei UI, Segoe UI"
                FontWeight="Bold"
                FontSize="56"
                LineHeight="56"
                CharacterSpacing="-20"
                Opacity="0"
                IsTextSelectionEnabled="False"
                RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleShift" Y="10" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
