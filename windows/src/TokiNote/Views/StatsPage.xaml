<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TokiNote.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="18" MaxWidth="880">
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="TodayLabel" FontSize="16" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="FocusLabel" Opacity="0.7" />
                        <TextBlock x:Name="TodayFocus" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock x:Name="BreakLabel" Opacity="0.7" />
                        <TextBlock x:Name="TodayBreak" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="WeekLabel" FontSize="16" />
            <TextBlock x:Name="WeekAverage" FontSize="32" FontWeight="SemiBold" />
            <TextBlock x:Name="WeekCaption" Opacity="0.65" />
            <StackPanel x:Name="WeekBars" Orientation="Horizontal" Spacing="8" Height="140" />
            <TextBlock x:Name="MonthLabel" FontSize="16" />
            <TextBlock x:Name="MonthAverage" FontSize="32" FontWeight="SemiBold" />
            <TextBlock x:Name="MonthCaption" Opacity="0.65" />
            <StackPanel x:Name="MonthBars" Orientation="Horizontal" Spacing="3" Height="72" />
        </StackPanel>
    </ScrollViewer>
</Page>
