<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TokiNote.FocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" ColumnSpacing="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="520" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Border Padding="24" CornerRadius="12" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid x:Name="ClockHost" PointerPressed="ClockHost_PointerPressed" PointerReleased="ClockHost_PointerReleased">
                <Ellipse Width="300" Height="300" StrokeThickness="12"
                         Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Ellipse x:Name="Ring" Width="300" Height="300" StrokeThickness="12"
                         Stroke="{ThemeResource SystemAccentColor}" StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="ModeText" HorizontalAlignment="Center" FontSize="14" Opacity="0.75" />
                    <TextBlock x:Name="ClockText" HorizontalAlignment="Center" FontSize="64" FontWeight="SemiBold" />
                    <TextBlock x:Name="SessionText" HorizontalAlignment="Center" Opacity="0.65" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center">
            <Button x:Name="ToggleButton" Height="48" HorizontalAlignment="Stretch" Click="ToggleButton_Click" Style="{ThemeResource AccentButtonStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ResetButton" Content="重置" Click="ResetButton_Click" />
                <Button x:Name="SkipButton" Content="跳过" Click="SkipButton_Click" />
                <Button x:Name="IndefiniteButton" Content="不定时专注" Click="IndefiniteButton_Click" />
            </StackPanel>
            <TextBlock x:Name="UpNextLabel" Opacity="0.55" FontSize="12" />
            <TextBlock x:Name="NextText" FontSize="16" />
            <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" />
        </StackPanel>
    </Grid>
</Page>
