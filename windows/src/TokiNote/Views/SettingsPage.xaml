<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TokiNote.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="16" MaxWidth="760">
            <TextBlock x:Name="AppearanceTitle" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ThemeLabel" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Checked="Theme_Checked" />
                <RadioButton x:Name="ThemeLight" GroupName="Theme" Checked="Theme_Checked" />
                <RadioButton x:Name="ThemeDark" GroupName="Theme" Checked="Theme_Checked" />
            </StackPanel>
            <ToggleSwitch x:Name="AmoledSwitch" Toggled="Setting_Toggled" />
            <ToggleSwitch x:Name="MotionSwitch" Toggled="Setting_Toggled" />
            <ToggleSwitch x:Name="TimeSwitch" Toggled="Setting_Toggled" />

            <TextBlock x:Name="TimerTitle" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Name="FocusLabel" />
            <NumberBox x:Name="FocusBox" Minimum="1" Maximum="180" SpinButtonPlacementMode="Inline" ValueChanged="Timer_Changed" />
            <TextBlock x:Name="ShortLabel" />
            <NumberBox x:Name="ShortBox" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" ValueChanged="Timer_Changed" />
            <TextBlock x:Name="LongLabel" />
            <NumberBox x:Name="LongBox" Minimum="1" Maximum="90" SpinButtonPlacementMode="Inline" ValueChanged="Timer_Changed" />
            <TextBlock x:Name="SessionsLabel" />
            <NumberBox x:Name="SessionsBox" Minimum="1" Maximum="12" SpinButtonPlacementMode="Inline" ValueChanged="Timer_Changed" />
            <ToggleSwitch x:Name="AutoSwitch" Toggled="Setting_Toggled" />

            <TextBlock x:Name="DataTitle" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Name="CountsText" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ExportButton" Click="ExportButton_Click" />
                <Button x:Name="ClearButton" Click="ClearButton_Click" />
            </StackPanel>

            <TextBlock x:Name="AboutTitle" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Name="VersionText" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="UpdateButton" Click="UpdateButton_Click" />
                <HyperlinkButton x:Name="GitHubButton" NavigateUri="https://github.com/ichiyotsu/TokiNote" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
