<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TokiNote.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- App-wide face: 微软雅黑 UI, then Segoe UI Variable (Windows 11), then Segoe UI (Windows 10). -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI, Segoe UI Variable, Segoe UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
